# ---------- Database ----------
DATABASE_URL="postgresql://user:password@localhost:5432/nobs_agent"

# ---------- Auth (Auth.js) ----------
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------- Storage ----------
# Cloudinary is what's actually wired up (signed uploads in
# src/lib/cloudinary.ts) — these three are required for uploads to work.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Supabase Storage was in the original brief as an alternative but isn't
# implemented — these are unused placeholders, safe to ignore or remove.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Payments ----------
# Paystack deposit flow is wired up (src/app/pay/[id], src/app/api/paystack/verify).
# Use a Starter Business key pair (no CAC registration needed) from
# paystack.com — Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Flutterwave and Stripe aren't wired up yet — placeholders for later.
FLUTTERWAVE_SECRET_KEY=""
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
# Stripe is NOT viable directly: Stripe merchant accounts cannot be created
# with a Nigerian address, phone number, BVN, or NIN. This isn't a config
# gap, it's a structural requirement on Stripe's side. Skipped for now.

# ---------- Email ----------
# Brevo (formerly Sendinblue) — free tier covers 300 emails/day.
# Get your key at app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@nobsagent.com"
STUDIO_NOTIFICATION_EMAIL="hello@nobsagent.com"

# ---------- Analytics (unused placeholder — GA isn't wired into the code yet) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------- Misc ----------
NEXT_PUBLIC_WHATSAPP_NUMBER="2340000000000"
# Digits only, country code first, no + sign, no spaces — used for the
# floating WhatsApp button (src/components/whatsapp-button.tsx). Change
# this any time; it's read live, no code changes needed.
NEXT_PUBLIC_CONTACT_EMAIL="hello@nobsagent.com"
NEXT_PUBLIC_CONTACT_PHONE="+234 000 000 0000"
# These two show on the /contact page (src/app/contact/page.tsx). Set your
# real email and phone number here.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
