// Prisma schema for NOBS AGENT
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts, not here, Prisma 7 moved
  // runtime connection settings out of schema.prisma. See that file.
}

// ---------- Auth & Users ----------

enum Role {
  ADMIN
  STAFF
  CLIENT
  REFERRER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          Role      @default(CLIENT)
  twoFactorSecret String?
  suspended     Boolean   @default(false)
  emailNotifications Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client?
  projects      Project[]      @relation("ProjectClient")
  messagesSent      Message[] @relation("MessageSender")
  messagesReceived  Message[] @relation("MessageRecipient")
  bookings      Booking[]
  auditLogs     AuditLog[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  paymentsAuthorized BookingPayment[] @relation("PaymentAuthorizedBy")
  referralPartner ReferralPartner?
  referral        Referral?
}

// Web Push subscription (one row per browser/device the user enabled
// notifications on). Used to deliver OS-level pushes for new bookings and
// inbox messages even when the site/app isn't open, mirrors what a
// WhatsApp-style notification needs: an endpoint + keys to send to.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Site content (drives the Admin CMS) ----------

// One row per editable text/image block. `page` + `key` together form a
// stable address (e.g. page="home", key="hero.title") so no copy is ever
// hardcoded in components, see src/lib/content.ts on the frontend, which
// is the fallback shape this table mirrors.
model SiteContent {
  id        String   @id @default(cuid())
  page      String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([page, key])
  @@index([page])
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String
  provider   String // "cloudinary" | "supabase"
  publicId   String?
  width      Int?
  height     Int?
  altText    String?
  createdAt  DateTime @default(now())
}

// ---------- Portfolio ----------

enum ProjectStatus {
  SUBMITTED
  IN_REVIEW
  IN_PROGRESS
  REVISION
  DELIVERED
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  problem     String   @db.Text
  solution    String   @db.Text
  results     String   @db.Text
  constraints String?  @db.Text
  architecture String? @db.Text
  keyEngineeringDecisions String? @db.Text
  security    String?  @db.Text
  performance String?  @db.Text
  industry    String
  technologies String[]
  durationWeeks Int?
  coverImage  String
  gallery     String[]
  videoUrl    String?
  liveUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  hidden      Boolean  @default(false)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  clientUserId String?
  clientUser  User?    @relation("ProjectClient", fields: [clientUserId], references: [id])
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Client-facing lifecycle (portal) ----
  status        ProjectStatus @default(SUBMITTED)
  clientBrief   String?       @db.Text // what the client originally submitted via /dashboard/new-project

  progress    ProjectProgress[]
  files       ProjectFile[]
  milestones  Milestone[]
  messages    Message[]
  testimonial Testimonial?
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProjectProgress {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  percentage Int
  note       String?
  createdAt  DateTime @default(now())
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  uploadedByRole Role
  createdAt DateTime @default(now())
}

// ---------- Clients & testimonials ----------

model Client {
  id           String   @id @default(cuid())
  name         String
  organization String?
  sector       String?
  logoUrl      String?
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  projects     Project[]
  testimonials Testimonial[]
  bookings     Booking[]
}

model Testimonial {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  projectId String?  @unique // set when submitted via the post-delivery dashboard popup
  project   Project? @relation(fields: [projectId], references: [id])
  quote     String   @db.Text
  rating    Int      @default(5)
  featured  Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- About page: engineer/founder profile ----------
// Singleton row (there's only ever one). Read/written by src/lib/data/founder.ts
// and /admin/founder.

model Founder {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String   @db.Text
  photoUrl    String?
  githubUrl   String?
  linkedinUrl String?
  updatedAt   DateTime @updatedAt
}

// ---------- Blog ----------

enum PostType {
  ARTICLE
  BUILD_LOG
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  coverImage  String?
  category    String?
  postType    PostType @default(ARTICLE)
  metaTitle   String?
  metaDescription String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Services & pricing ----------

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String
  startingPrice Int?
  order       Int      @default(0)
  active      Boolean  @default(true)
}

model PricingPlan {
  id        String   @id @default(cuid())
  name      String
  description String?
  price     Int
  currency  String   @default("NGN")
  interval  String? // "one-time" | "monthly" | "yearly"
  features  String[]
  highlighted Boolean @default(false)
  order     Int      @default(0)
}

// ---------- Booking ----------

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

model Booking {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  fullName      String
  email         String
  serviceInterest String
  budgetRange   String
  meetingType   String // "video" | "phone" | "in-person"
  scheduledFor  DateTime
  briefUrl      String?
  notes         String?       @db.Text
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  // ---- Terms & Conditions acceptance, captured at submission time ----
  // Set only by the server (never trust a client-supplied timestamp/IP) the
  // moment a booking is created — the checkbox on the booking form is
  // `required`, so a booking can't be submitted without it. Null on
  // bookings created before this was added; the agreement PDF falls back to
  // a generic note for those instead of erroring.
  termsAcceptedAt DateTime?
  termsAcceptedIp String?

  // ---- Deposit / payment (set when admin confirms with an agreed price) ----
  // Amounts are stored in kobo (smallest NGN unit) to match Paystack's API
  // directly, ₦1,000 is stored as 100000. Avoids unit-conversion bugs at
  // the one place it actually matters, sending the number to Paystack.
  agreedAmount      Int?     // total agreed project price, in kobo
  depositPercentage Int?     // minimum 45, admin can set higher, validated in the action, not the DB
  depositAmount     Int?     // agreedAmount * depositPercentage / 100, the required MINIMUM first payment
  depositPaid       Boolean  @default(false) // true once the minimum first payment has cleared
  amountPaid        Int      @default(0) // running total actually received across all installments, in kobo
  paystackReference String?  @unique // kept for the first/deposit payment, for backward compatibility
  depositPaidAt     DateTime?
  // Set (or re-set) the moment an admin confirms this booking with a price
  // — i.e. the instant the data the Client Service Agreement is generated
  // from becomes real. This is what the agreement is dated against, not
  // `createdAt`, so the document always reflects when the CURRENT price was
  // actually agreed, not when the booking was first requested.
  confirmedAt       DateTime?

  payments BookingPayment[]
  files    BookingFile[]
}

model BookingPayment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  amount            Int           // this specific installment, in kobo
  provider          String        @default("paystack") // "paystack" | "flutterwave" | "manual"
  reference         String        @unique
  createdAt         DateTime      @default(now())

  // ---- Admin manual authorization (set only when provider = "manual") ----
  // Admin can authorize a payment independent of gateway confirmation, this
  // is the audit trail for that override: who did it, what the booking's
  // status was beforehand, and any context note.
  authorizedByUserId String?
  authorizedBy       User?    @relation("PaymentAuthorizedBy", fields: [authorizedByUserId], references: [id])
  priorGatewayStatus String?  // snapshot, e.g. "PENDING" or "no gateway confirmation"
  note               String?  @db.Text

  referralCommissions ReferralCommission[]
}

model BookingFile {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id])
  url            String
  fileName       String
  uploadedByRole Role
  createdAt      DateTime @default(now())
}

// ---------- Referral partner program ----------
// A partner (Role = REFERRER) gets a shareable code; a prospective client
// who signs up through that link becomes a Referral (see middleware.ts for
// cookie capture and src/app/signup/actions.ts for the link between them).
// Commission is recorded per BookingPayment, not per Referral, since a
// client can pay in installments and each installment earns commission
// separately — see src/lib/referral-tier.ts for the rate math and the
// three payment-transaction call sites (Paystack/Flutterwave verify,
// admin manual authorization) for where ReferralCommission rows are created.

model ReferralPartner {
  id                String     @id @default(cuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id])
  referralCode      String     @unique
  // Lifetime count of referrals that have made at least one payment, used
  // to compute which commission tier the NEXT converting referral lands
  // in. Never decremented except by the admin "clear test data" reset.
  paidReferralCount Int        @default(0)
  bankDetails       String?    @db.Text
  // Paystack payout automation — set once the partner completes the
  // "Payout details" flow on their dashboard. bankCode/accountNumber are
  // what was submitted; accountName is what Paystack resolved it to
  // (shown back to the partner for confirmation before saving).
  bankCode                String?
  accountNumber           String?
  accountName             String?
  paystackSubaccountCode  String?    @unique
  subaccountSetupAt       DateTime?
  suspended         Boolean    @default(false)
  createdAt         DateTime   @default(now())

  // ---- Monthly activity enforcement (Agreement clause 7.5) ----
  // Checked by the monthly cron in src/app/api/cron/check-partner-activity
  // (src/lib/referral-partner-activity.ts). Counts consecutive calendar
  // months with zero converted referrals; a month with at least one resets
  // it to 0. Reaching 3 auto-suspends the partner (freeing their seat for
  // the waitlist) — see suspendPartnerAndPromoteNext in
  // src/lib/referral-partner-suspension.ts.
  consecutiveInactiveMonths Int      @default(0)
  // "YYYY-MM" of the last calendar month this partner was evaluated for —
  // guards against double-processing if the cron ever fires more than
  // once for the same month.
  lastActivityCheckedMonth String?

  // Two-tier referral program: a partner can recruit another partner
  // instead of (or as well as) referring clients directly. Only ever one
  // level is looked at for payout purposes (see ReferralCommission's
  // recipientPartnerId) — recruitedBy is stored so the admin drill-down UI
  // can walk the full recruiting tree, and so the recruiter can be found
  // when a recruit's own referral pays out. Gated behind
  // ReferralProgramSettings.multiLevelReferralsEnabled — see that model.
  recruitedByPartnerId String?
  recruitedBy           ReferralPartner?  @relation("PartnerRecruits", fields: [recruitedByPartnerId], references: [id])
  recruits               ReferralPartner[] @relation("PartnerRecruits")

  // Cached Paystack Transaction Split code for the (this partner, this
  // partner's recruiter) pair, created lazily the first time both have
  // connected payout details. Reused on every subsequent payment instead
  // of calling Paystack's split-create endpoint again.
  paystackSplitCode String? @unique

  referrals         Referral[]
  // Override commissions earned off referrals that belong to partners
  // THIS partner recruited (see ReferralCommission.recipientPartnerId) —
  // separate from `referrals`, which is only this partner's own direct
  // client referrals.
  overrideCommissions ReferralCommission[]

  @@index([referralCode])
  @@index([recruitedByPartnerId])
}

// Single-row admin-editable settings for the referral partner program —
// see src/lib/referral-program-settings.ts. Always read/written against
// the fixed id "singleton"; a missing row means "use the defaults", so
// nothing else needs to seed one.
model ReferralProgramSettings {
  id                          String   @id @default("singleton")
  partnerCapacity             Int      @default(100)
  // Off at launch: a middleman can only refer clients, not other
  // middlemen, until the admin explicitly turns this on. See AGENTS.md /
  // conversation history for why — the two-tier program ships dormant.
  multiLevelReferralsEnabled  Boolean  @default(false)
  updatedAt                   DateTime @updatedAt
  updatedBy                   String?
}

// Holds everyone who applied while all ReferralPartner slots (capacity in
// ReferralProgramSettings) were taken. No User/ReferralPartner row exists
// for them yet — passwordHash is captured up front so promotion later
// doesn't need to ask them to sign up again. Position in the queue is
// always computed live (createdAt order among promotedAt: null rows), not
// stored, so nothing needs renumbering when someone is promoted.
// Promotion happens in src/lib/referral-partner-waitlist.ts, triggered the
// moment a seat frees up (see togglePartnerSuspended in
// src/app/admin/partners/actions.ts) — always inside the advisory-locked
// transaction from src/lib/referral-partner-lock.ts, the same lock every
// capacity-changing write goes through, so a seat can never be double-
// promised under concurrent requests.
model ReferralPartnerWaitlist {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  phone             String
  passwordHash      String
  // Raw ?ref= code captured at the moment they joined the waitlist,
  // re-resolved to a recruiter at promotion time (not resolved up front)
  // since the recruiter's standing, or the multi-level toggle itself, may
  // have changed by the time a seat actually opens up, sometimes months
  // later.
  refCode           String?
  promotedAt        DateTime?
  promotedPartnerId String?   @unique
  createdAt         DateTime  @default(now())

  @@index([promotedAt, createdAt])
}

enum ReferralStatus {
  PENDING
  CONVERTED
  DISQUALIFIED
}

model Referral {
  id             String         @id @default(cuid())
  partnerId      String
  partner        ReferralPartner @relation(fields: [partnerId], references: [id])
  referredUserId String         @unique
  referredUser   User           @relation(fields: [referredUserId], references: [id])
  status         ReferralStatus @default(PENDING)
  // Locked in the moment this referral first pays, based on where it fell
  // in the partner's paidReferralCount sequence at that instant. Later
  // referrals crossing into bonus territory don't change this.
  commissionRatePercent       Int?
  tierPositionAtQualification Int?
  disqualifiedReason String?   @db.Text
  createdAt      DateTime      @default(now())
  convertedAt    DateTime?

  commissions    ReferralCommission[]

  @@index([partnerId])
}

model ReferralCommission {
  id               String         @id @default(cuid())
  referralId       String
  referral         Referral       @relation(fields: [referralId], references: [id])
  // Not unique: a bonus-tier (20%) payment creates TWO rows against the
  // same BookingPayment — one for the base 10% (auto-split via Paystack
  // when the partner has a subaccount) and one for the extra 10% bonus
  // portion (always manual, see isBonusPortion). A base-tier payment with
  // a recruiting partner in the chain creates a THIRD row for the 5%
  // override (see isOverridePortion) — never during the bonus tier, that
  // stays a flat 80/20 between NOBS and whoever qualified for it.
  bookingPaymentId String
  bookingPayment   BookingPayment @relation(fields: [bookingPaymentId], references: [id])
  amount           Int            // kobo
  isBonusPortion   Boolean        @default(false)
  isOverridePortion Boolean       @default(false)
  // Who this specific row is owed to. Null means "the referral's own
  // partner" (referral.partnerId) — true for every row before the
  // two-tier program existed, and for every base/bonus row since. Only an
  // override row sets this explicitly, to the recruiter one hop up —
  // never the referral's own partner, and never further up the chain.
  recipientPartnerId String?
  recipientPartner   ReferralPartner? @relation(fields: [recipientPartnerId], references: [id])
  paidOut          Boolean        @default(false)
  paidOutAt        DateTime?
  // Set only when a Paystack subaccount was attached to this payment (an
  // auto-payout is genuinely in flight) — Paystack settles a split to the
  // linked bank account 1-2 business days later, never instantly, so the
  // "you earned a commission" email/notification and the paidOut flip both
  // wait until this passes (see the cron at
  // src/app/api/cron/settle-commissions/route.ts). Null means there's no
  // subaccount at all, so nothing to wait for — that case still fires
  // immediately, it just says "you'll be paid manually" rather than
  // implying money already moved.
  autoSettlesAt    DateTime?
  createdAt        DateTime       @default(now())

  @@index([referralId])
  @@index([bookingPaymentId])
  @@index([recipientPartnerId])
  @@index([paidOut, autoSettlesAt])
}

// ---------- Messaging & contact ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String   @db.Text
  source    String   @default("contact_form") // "contact_form" | "whatsapp" | "email"
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  replies InquiryReply[]
}

model InquiryReply {
  id              String         @id @default(cuid())
  contactMessageId String
  contactMessage  ContactMessage @relation(fields: [contactMessageId], references: [id])
  fromAdmin       Boolean
  body            String         @db.Text
  attachmentUrl   String?
  attachmentName  String?
  createdAt       DateTime       @default(now())
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  // When set, this is a direct admin reply routed to a specific client's
  // inbox. When null and the sender is a client, it's understood to go to
  // "the studio" generally, any admin can see and answer it. This is what
  // powers the private inbox, separate from the per-project comment
  // threads (projectId below), which stay project-scoped.
  recipientId String?
  recipient   User?    @relation("MessageRecipient", fields: [recipientId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  body        String   @db.Text
  attachmentUrl  String?
  attachmentName String?
  deliveredAt DateTime? // set once the recipient's inbox has loaded this message
  readAt      DateTime? // set once the recipient has actually opened the thread
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String?
  link      String?  // e.g. /pay/[bookingId], powers the "Continue" button in the inbox
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ---------- Careers ----------

model Job {
  id           String   @id @default(cuid())
  title        String
  department   String?
  location     String   @default("Remote")
  type         String   @default("Full-time") // "Full-time" | "Part-time" | "Contract"
  description  String   @db.Text
  requirements String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[]
}

enum ApplicationStatus {
  RECEIVED
  IN_REVIEW
  INTERVIEWING
  REJECTED
  HIRED
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id])
  name        String
  email       String
  coverLetter String            @db.Text
  resumeUrl   String?
  status      ApplicationStatus @default(RECEIVED)
  // No account needed to view or continue the conversation, this token is
  // the applicant's private key, emailed to them, same pattern as the
  // payment page's booking id.
  accessToken String            @unique @default(cuid())
  createdAt   DateTime          @default(now())

  messages JobMessage[]
}

model JobMessage {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id])
  fromAdmin     Boolean // true = studio wrote this, false = applicant wrote this
  body          String         @db.Text
  attachmentUrl String?
  attachmentName String?
  readByAdmin   Boolean        @default(false)
  readByApplicant Boolean      @default(false)
  createdAt     DateTime       @default(now())
}

// ---------- Analytics & audit ----------

model PageView {
  id          String   @id @default(cuid())
  path        String
  country     String?
  device      String?
  referrer    String?
  visitorHash String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([path])
  @@index([visitorHash])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
